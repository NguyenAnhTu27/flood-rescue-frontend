VITE_API_BASE_URL=http://localhost:8080/api
VITE_FILE_BASE_URL=http://localhost:8080
VITE_APP_NAME=Hệ thống Cứu hộ
VITE_APP_VERSION=1.0.0

# Mapbox public token (chỉ dùng cho FE, không phải secret)
VITE_MAPBOX_ACCESS_TOKEN=your_public_mapbox_token_here

# Map style (có thể thay bằng style riêng)
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12

# (Tuỳ chọn) Endpoint backend dùng Mapbox để reverse geocode, ví dụ:
# http://localhost:8080/api/mapbox/reverse-geocode?lat={lat}&lng={lng}
VITE_MAPBOX_REVERSE_GEOCODE_URL=

